{
  "name": "trace360-frontend",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.gen.ts && git diff --exit-code -- src/api/schema.gen.ts"
  },
  "dependencies": {
    "cytoscape": "3.30.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "recharts": "2.13.3"
  },
  "devDependencies": {
    "@types/cytoscape": "3.21.8",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.1",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "6.4.4"
  }
}
